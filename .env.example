# ============================================================
# ARCHIVO DE CONFIGURACIÓN - TICKETS SYSTEM
# ============================================================
# Instrucciones:
# 1. Copiar este archivo: cp .env.example .env
# 2. Editar .env con tus valores
# 3. Ejecutar: docker-compose up -d
# ============================================================

# ============================================================
# 🗄️ BASE DE DATOS - PostgreSQL
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================================
# 🔑 DJANGO - Configuración
# ============================================================
# IMPORTANTE: Generar una nueva SECRET_KEY para producción
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key

# Modo debug (True desarrollo, False producción)
DEBUG=True

# Hosts permitidos (separar con comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF para dominios (producción)
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# ============================================================
# 🚪 PUERTOS (desarrollo local)
# ============================================================
WEB_PORT=8000
POSTGRES_PORT=5432

# ============================================================
# 👤 SUPERUSUARIO INICIAL (se crea automáticamente)
# ============================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost.com
DJANGO_SUPERUSER_PASSWORD=admin123456

